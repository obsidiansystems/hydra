  "query": "\n            SELECT\n              id, buildStatus, releaseName, closureSize, size, o.storeDir as \"storedir!\"\n            FROM builds b\n            JOIN buildoutputs o on b.id = o.build\n            WHERE finished = 1 and (buildStatus = 0 or buildStatus = 6) and path = $1;",
